{
  "name": "rblink.chat",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade real-time collaboration and chat platform inspired by Slack and Discord",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node tests/test-runner.js",
    "zip": "powershell -Command \"Compress-Archive -Path * -DestinationPath ../rblink.chat.zip -Force\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
