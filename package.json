{
  "name": "rblink.chat",
  "version": "4.0.0",
  "private": true,
  "description": "Enterprise-grade real-time collaboration and chat platform inspired by Slack and Discord",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "npm run build && npm run serve",
    "test": "node tests/test-runner.js && node --test tests/merge.test.js tests/server.test.js tests/platform.test.js tests/resilience.test.js tests/storage.test.js",
    "serve": "node --env-file-if-exists=.env server/index.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "migrate:uploads": "node --env-file-if-exists=.env scripts/migrate-uploads.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}