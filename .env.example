# Copy this file to a new file named exactly:  .env   (then fill in what you need).
# Everything is optional for a first local test.

PORT=3001
# Public address of your site (used in password-reset and invite links). Example: https://rblink.onrender.com
APP_URL=
# Folder where accounts, posts and uploads are saved. On a host, point this at a persistent disk.
DATA_DIR=./data
# Long random text. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to production when your site is live (hides test shortcuts such as showing reset links/codes on screen).
NODE_ENV=development
# Biggest upload in megabytes (photos, videos, voice notes, CVs).
UPLOAD_MAX_MB=100

# --- Google sign-in (free) ---
GOOGLE_CLIENT_ID=

# --- Email for password recovery and job applications (Mailgun, free tier) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=

# --- SMS codes for phone sign-in (Twilio; trial credit is free) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- AI assistant: any OpenAI-compatible service. Free examples:
# Groq:   AI_BASE_URL=https://api.groq.com/openai/v1        AI_MODEL=llama-3.3-70b-versatile
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Meetings and live rooms ---
# Max people in one meeting (peer-to-peer video gets heavy above ~8).
ROOM_MAX=8
# Optional TURN servers so video works behind strict networks. JSON, e.g. [{"urls":"turn:host:3478","username":"u","credential":"p"}]
ICE_SERVERS=
